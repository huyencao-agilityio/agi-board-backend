{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm format)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm build)",
      "Bash(pnpm db:up)",
      "Bash(pnpm db:check)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:migrate:dev)",
      "Bash(pnpm db:migrate:new *)",
      "Bash(pnpm db:seed)",
      "Bash(pnpm prisma generate)",
      "Bash(pnpm prisma format)",
      "Bash(pnpm prisma validate)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(pnpm prisma db push *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  }
}
