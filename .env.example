# Local overrides for `wrangler dev` (copy to .dev.vars or .env). Defaults live in wrangler.jsonc "vars".
# The database (D1) and image storage (R2) are bindings in wrangler.jsonc, not variables.
# Deployed values: wrangler.jsonc env.staging / env.production "vars"; secrets with `wrangler secret put --env <env>`.
NODE_ENV=development
# Frontend origin, for CORS and cookies.
APP_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=agi_sid
SMTP_HOST=localhost
SMTP_PORT=1025
LOG_LEVEL=debug
