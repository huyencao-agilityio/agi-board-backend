# Local overrides for `wrangler dev` (copy to .dev.vars or .env). Defaults live in wrangler.jsonc "vars".
# The database (D1) and image storage (R2) are bindings in wrangler.jsonc, not variables.
# Deployed values: wrangler.jsonc env.staging / env.production "vars"; secrets with `wrangler secret put --env <env>`.
NODE_ENV=development
# Frontend origin, for CORS and cookies.
APP_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=agi_sid
LOG_LEVEL=debug
# Google sign-in (optional outside production; required when NODE_ENV=production).
# The secret is set with `wrangler secret put GOOGLE_CLIENT_SECRET --env <env>` when deployed.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Callback registered in Google Cloud; goes through the frontend origin, which proxies /api to this backend.
# GOOGLE_REDIRECT_URI=http://localhost:8787/api/v1/auth/google/callback
# Email through Resend (required when NODE_ENV=production). Unset locally: emails go to Mailpit (`pnpm mail:up`).
# The key is set with `wrangler secret put EMAIL_API_KEY --env <env>` when deployed.
# EMAIL_API_KEY=
# EMAIL_FROM="AGI Board <no-reply@example.com>"
# Swagger UI at /api/docs: on unless NODE_ENV=production; set true to force it on (staging), false to force it off.
# ENABLE_DOCS=true
# Days without activity before a session expires (default 7).
# SESSION_IDLE_DAYS=7
# PBKDF2-SHA256 iterations for passwords (default 10000, sized for the Workers free plan; OWASP: 600000).
# PASSWORD_PBKDF2_ITERATIONS=10000
