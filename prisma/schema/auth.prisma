/// Has CHECK constraints: see the manual block in the init migration.
/// Has expression indexes: see the manual block in the init migration.
model User {
  id                     String                  @id @default(uuid(7))
  email                  String                  @unique
  fullName               String                  @map("full_name")
  avatarObjectKey        String?                 @map("avatar_object_key")
  passwordHash           String?                 @map("password_hash")
  googleSubject          String?                 @unique @map("google_subject")
  emailVerifiedAt        DateTime?               @map("email_verified_at")
  systemRole             SystemRole              @default(user) @map("system_role")
  roleBeforeDeactivation SystemRole?             @map("role_before_deactivation")
  deactivatedAt          DateTime?               @map("deactivated_at")
  deactivatedById        String?                 @map("deactivated_by_id")
  lastSignInAt           DateTime?               @map("last_sign_in_at")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @default(now()) @updatedAt @map("updated_at")
  activities             Activity[]
  attachments            Attachment[]
  auditLogEntries        AuditLogEntry[]
  boardMembers           BoardMember[]
  boardStars             BoardStar[]
  boardViews             BoardView[]
  boardsClosedBy         Board[]                 @relation("BoardClosedBy")
  boardsCreatedBy        Board[]                 @relation("BoardCreatedBy")
  cardLinks              CardLink[]
  cardMembers            CardMember[]
  cardWatchers           CardWatcher[]
  cardsArchivedBy        Card[]                  @relation("CardArchivedBy")
  cardsCompletedBy       Card[]                  @relation("CardCompletedBy")
  cardsCreatedBy         Card[]                  @relation("CardCreatedBy")
  comments               Comment[]
  emailVerificationCodes EmailVerificationCode[]
  invitesInvitedBy       Invite[]                @relation("InviteInvitedBy")
  invitesRespondedBy     Invite[]                @relation("InviteRespondedBy")
  lists                  List[]
  notificationsActor     Notification[]          @relation("NotificationActor")
  notificationsRecipient Notification[]          @relation("NotificationRecipient")
  passwordResetTokens    PasswordResetToken[]
  sessions               UserSession[]
  deactivatedBy          User?                   @relation("UserDeactivatedBy", fields: [deactivatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usersDeactivatedBy     User[]                  @relation("UserDeactivatedBy")
  workspaceMembers       WorkspaceMember[]
  workspacesArchivedBy   Workspace[]             @relation("WorkspaceArchivedBy")
  workspacesCreatedBy    Workspace[]             @relation("WorkspaceCreatedBy")

  @@index([id], map: "idx_users_active_super_admin", where: raw("((system_role = 'super_admin') AND (deactivated_at IS NULL))"))
  @@index([deactivatedById], map: "idx_users_deactivated_by_id")
  @@map("users")
}

/// Has CHECK constraints: see the manual block in the init migration.
model UserSession {
  id           String            @id @default(uuid(7))
  userId       String            @map("user_id")
  tokenHash    String            @unique @map("token_hash")
  userAgent    String?           @map("user_agent")
  ipAddress    String?           @map("ip_address")
  lastActiveAt DateTime          @default(now()) @map("last_active_at")
  endedAt      DateTime?         @map("ended_at")
  endReason    SessionEndReason? @map("end_reason")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at")
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, lastActiveAt(sort: Desc)], map: "idx_user_sessions_user_active", where: raw("(ended_at IS NULL)"))
  @@index([userId], map: "idx_user_sessions_user_id")
  @@map("user_sessions")
}

/// Has CHECK constraints: see the manual block in the init migration.
model EmailVerificationCode {
  id             String    @id @default(uuid(7))
  userId         String    @map("user_id")
  codeHash       String    @map("code_hash")
  failedAttempts Int       @default(0) @map("failed_attempts")
  expiresAt      DateTime  @map("expires_at")
  consumedAt     DateTime? @map("consumed_at")
  voidedAt       DateTime? @map("voided_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId], map: "uq_email_verification_codes_live", where: raw("((consumed_at IS NULL) AND (voided_at IS NULL))"))
  @@index([userId], map: "idx_email_verification_codes_user_id")
  @@map("email_verification_codes")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7))
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  voidedAt  DateTime? @map("voided_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId], map: "uq_password_reset_tokens_live", where: raw("((used_at IS NULL) AND (voided_at IS NULL))"))
  @@index([userId], map: "idx_password_reset_tokens_user_id")
  @@map("password_reset_tokens")
}

model AuthThrottle {
  id          String            @id @default(uuid(7))
  scope       AuthThrottleScope
  subjectKey  String            @map("subject_key")
  failedCount Int               @default(0) @map("failed_count")
  lockedUntil DateTime?         @map("locked_until")
  lastSentAt  DateTime?         @map("last_sent_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at")

  @@unique([scope, subjectKey])
  @@map("auth_throttles")
}
