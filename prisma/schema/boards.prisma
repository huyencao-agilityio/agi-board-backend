/// Has CHECK constraints: see the manual block in the init migration.
/// Has expression indexes: see the manual block in the init migration.
model Board {
  id                  String           @id @default(uuid(7))
  workspaceId         String           @map("workspace_id")
  name                String
  visibility          BoardVisibility  @default(workspace)
  backgroundKey       String?          @map("background_key")
  backgroundObjectKey String?          @map("background_object_key")
  /// One of the 10 preset colors (CHECK in migration 0002); random per board, shown when no image is set.
  backgroundColor     String           @default("#0d9488") @map("background_color")
  nextCardNumber      Int              @default(1) @map("next_card_number")
  closedAt            DateTime?        @map("closed_at")
  closedById          String?          @map("closed_by_id")
  createdById         String           @map("created_by_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at")
  activities          Activity[]
  boardMembers        BoardMember[]
  boardStars          BoardStar[]
  boardViews          BoardView[]
  background          BoardBackground? @relation(fields: [backgroundKey], references: [id], onDelete: NoAction, onUpdate: NoAction)
  closedBy            User?            @relation("BoardClosedBy", fields: [closedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy           User             @relation("BoardCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspace           Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cards               Card[]
  invites             Invite[]
  labels              Label[]
  lists               List[]

  @@index([backgroundKey], map: "idx_boards_background_key")
  @@index([closedById], map: "idx_boards_closed_by_id")
  @@index([createdById], map: "idx_boards_created_by_id")
  @@index([workspaceId], map: "idx_boards_workspace_id")
  @@map("boards")
}

model BoardMember {
  id        String     @id @default(uuid(7))
  boardId   String     @map("board_id")
  userId    String     @map("user_id")
  role      MemberRole @default(member)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")
  board     Board      @relation(fields: [boardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([boardId, userId])
  @@index([boardId], map: "idx_board_members_board_id")
  @@index([userId], map: "idx_board_members_user_id")
  @@map("board_members")
}

model BoardStar {
  id        String   @id @default(uuid(7))
  userId    String   @map("user_id")
  boardId   String   @map("board_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, boardId])
  @@index([boardId], map: "idx_board_stars_board_id")
  @@index([userId], map: "idx_board_stars_user_id")
  @@map("board_stars")
}

model BoardView {
  id           String   @id @default(uuid(7))
  userId       String   @map("user_id")
  boardId      String   @map("board_id")
  lastViewedAt DateTime @default(now()) @map("last_viewed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  board        Board    @relation(fields: [boardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, boardId])
  @@index([boardId], map: "idx_board_views_board_id")
  @@index([userId, lastViewedAt(sort: Desc)], map: "idx_board_views_user_recent")
  @@map("board_views")
}

model Label {
  id         String      @id @default(uuid(7))
  boardId    String      @map("board_id")
  name       String      @default("")
  colorKey   String      @map("color_key")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at")
  cardLabels CardLabel[]
  board      Board       @relation(fields: [boardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  color      LabelColor  @relation(fields: [colorKey], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([boardId], map: "idx_labels_board_id")
  @@index([colorKey], map: "idx_labels_color_key")
  @@map("labels")
}

/// Has CHECK constraints: see the manual block in the init migration.
model List {
  id           String    @id @default(uuid(7))
  boardId      String    @map("board_id")
  name         String
  pos          Float
  archivedAt   DateTime? @map("archived_at")
  archivedById String?   @map("archived_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  cards        Card[]
  archivedBy   User?     @relation(fields: [archivedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  board        Board     @relation(fields: [boardId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id, boardId])
  @@index([archivedById], map: "idx_lists_archived_by_id")
  @@index([boardId, archivedAt(sort: Desc)], map: "idx_lists_board_archived", where: raw("(archived_at IS NOT NULL)"))
  @@index([boardId], map: "idx_lists_board_id")
  @@index([boardId, pos], map: "idx_lists_board_pos_active", where: raw("(archived_at IS NULL)"))
  @@map("lists")
}
