/// Has CHECK constraints: see the manual block in the init migration.
/// Has expression indexes: see the manual block in the init migration.
model Card {
  id                    String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  boardId               String         @map("board_id") @db.Uuid
  listId                String         @map("list_id") @db.Uuid
  number                Int
  title                 String
  description           String?
  pos                   Float
  coverColor            String?        @map("cover_color")
  startAt               DateTime?      @map("start_at") @db.Timestamptz(6)
  dueAt                 DateTime?      @map("due_at") @db.Timestamptz(6)
  reminderOffsetMinutes Int?           @map("reminder_offset_minutes")
  reminderAt            DateTime?      @map("reminder_at") @db.Timestamptz(6)
  reminderSentForDue    DateTime?      @map("reminder_sent_for_due") @db.Timestamptz(6)
  completedAt           DateTime?      @map("completed_at") @db.Timestamptz(6)
  completedById         String?        @map("completed_by_id") @db.Uuid
  archivedAt            DateTime?      @map("archived_at") @db.Timestamptz(6)
  archivedById          String?        @map("archived_by_id") @db.Uuid
  createdById           String         @map("created_by_id") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  activities            Activity[]
  attachments           Attachment[]
  cardLabels            CardLabel[]
  cardLinksSourceCard   CardLink[]     @relation("CardLinkSourceCard")
  cardLinksTargetCard   CardLink[]     @relation("CardLinkTargetCard")
  cardMembers           CardMember[]
  cardWatchers          CardWatcher[]
  archivedBy            User?          @relation("CardArchivedBy", fields: [archivedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  board                 Board          @relation(fields: [boardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  completedBy           User?          @relation("CardCompletedBy", fields: [completedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy             User           @relation("CardCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  list                  List           @relation(fields: [listId, boardId], references: [id, boardId], onDelete: NoAction)
  checklists            Checklist[]
  comments              Comment[]
  notifications         Notification[]

  @@unique([boardId, number], map: "uq_cards_board_number")
  @@index([archivedById], map: "idx_cards_archived_by_id")
  @@index([boardId, archivedAt(sort: Desc)], map: "idx_cards_board_archived", where: raw("(archived_at IS NOT NULL)"))
  @@index([boardId], map: "idx_cards_board_id")
  @@index([completedById], map: "idx_cards_completed_by_id")
  @@index([createdById], map: "idx_cards_created_by_id")
  @@index([listId], map: "idx_cards_list_id")
  @@index([listId, pos], map: "idx_cards_list_pos_active", where: raw("(archived_at IS NULL)"))
  @@index([reminderAt], map: "idx_cards_reminder_due", where: raw("((reminder_at IS NOT NULL) AND (completed_at IS NULL) AND (archived_at IS NULL))"))
  @@map("cards")
}

model CardLabel {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  cardId    String   @map("card_id") @db.Uuid
  labelId   String   @map("label_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([cardId, labelId])
  @@index([cardId], map: "idx_card_labels_card_id")
  @@index([labelId], map: "idx_card_labels_label_id")
  @@map("card_labels")
}

model CardMember {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  cardId    String   @map("card_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cardId, userId])
  @@index([cardId], map: "idx_card_members_card_id")
  @@index([userId], map: "idx_card_members_user_id")
  @@map("card_members")
}

