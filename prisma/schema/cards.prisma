model CardLink {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sourceCardId String       @map("source_card_id") @db.Uuid
  targetCardId String       @map("target_card_id") @db.Uuid
  type         CardLinkType
  createdById  String       @map("created_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sourceCard   Card         @relation("CardLinkSourceCard", fields: [sourceCardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  targetCard   Card         @relation("CardLinkTargetCard", fields: [targetCardId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdById], map: "idx_card_links_created_by_id")
  @@index([sourceCardId], map: "idx_card_links_source_card_id")
  @@index([targetCardId], map: "idx_card_links_target_card_id")
  @@map("card_links")
}

