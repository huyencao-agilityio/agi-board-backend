/// Has CHECK constraints: see the manual block in the init migration.
model Workspace {
  id                    String            @id @default(uuid(7))
  name                  String
  closedBoardDeleteRule RuleScope         @default(workspace_admins) @map("closed_board_delete_rule")
  outsideInviteRule     RuleScope         @default(workspace_admins) @map("outside_invite_rule")
  archivedAt            DateTime?         @map("archived_at")
  archivedById          String?           @map("archived_by_id")
  createdById           String            @map("created_by_id")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at")
  auditLogEntries       AuditLogEntry[]
  boards                Board[]
  invites               Invite[]
  notifications         Notification[]
  workspaceMembers      WorkspaceMember[]
  archivedBy            User?             @relation("WorkspaceArchivedBy", fields: [archivedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy             User              @relation("WorkspaceCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([archivedById], map: "idx_workspaces_archived_by_id")
  @@index([createdById], map: "idx_workspaces_created_by_id")
  @@map("workspaces")
}

model WorkspaceMember {
  id          String     @id @default(uuid(7))
  workspaceId String     @map("workspace_id")
  userId      String     @map("user_id")
  role        MemberRole @default(member)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at")
  user        User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([workspaceId, userId])
  @@index([workspaceId], map: "idx_workspace_members_admins", where: raw("(role = 'admin')"))
  @@index([userId], map: "idx_workspace_members_user_id")
  @@index([workspaceId], map: "idx_workspace_members_workspace_id")
  @@map("workspace_members")
}

/// Has CHECK constraints: see the manual block in the init migration.
model Invite {
  id            String         @id @default(uuid(7))
  workspaceId   String         @map("workspace_id")
  boardId       String?        @map("board_id")
  email         String
  role          MemberRole     @default(member)
  status        InviteStatus   @default(pending)
  invitedById   String         @map("invited_by_id")
  lastSentAt    DateTime       @default(now()) @map("last_sent_at")
  expiresAt     DateTime       @map("expires_at")
  respondedAt   DateTime?      @map("responded_at")
  respondedById String?        @map("responded_by_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")
  board         Board?         @relation(fields: [boardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invitedBy     User           @relation("InviteInvitedBy", fields: [invitedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  respondedBy   User?          @relation("InviteRespondedBy", fields: [respondedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  notifications Notification[]

  @@unique([workspaceId, boardId, email], map: "uq_invites_pending_target", where: raw("(status = 'pending')"))
  @@index([boardId], map: "idx_invites_board_id")
  @@index([invitedById], map: "idx_invites_invited_by_id")
  @@index([email], map: "idx_invites_pending_email", where: raw("(status = 'pending')"))
  @@index([respondedById], map: "idx_invites_responded_by_id")
  @@index([workspaceId], map: "idx_invites_workspace_id")
  @@map("invites")
}
