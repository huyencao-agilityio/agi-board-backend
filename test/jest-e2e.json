{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "query_compiler_fast_bg\\.wasm(\\?module)?$": "<rootDir>/setup/prisma-wasm.js",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "globalSetup": "<rootDir>/setup/global-setup.ts",
  "setupFilesAfterEnv": [
    "<rootDir>/setup/bindings.ts"
  ]
}
